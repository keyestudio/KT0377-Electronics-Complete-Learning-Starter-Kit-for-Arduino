#include <IRremote.h> // Подключение библиотеки ИК (требуется версия 2.0.1)

// --- 1. Определение пина ИК-приёмника и создание объекта ---
const int RECV_PIN = 2; // Пин сигнала ИК-приёмника D2
IRrecv irrecv(RECV_PIN); // Создание объекта ИК-приёмника
decode_results results;  // Объект для хранения результатов декодирования

// --- 2. Определение пинов управления мотором L293D ---
const int enablePin = 10; // D10: управление скоростью мотора (PWM)
const int in1Pin = 11;    // D11: управление направлением мотора 1
const int in2Pin = 9;     // D9:  управление направлением мотора 2

void setup() {
  Serial.begin(9600);      // Инициализация последовательного порта, скорость 9600
  irrecv.enableIRIn();     // Запуск ИК-приёмника

  // Установка пинов мотора в режим вывода
  pinMode(enablePin, OUTPUT);
  pinMode(in1Pin, OUTPUT);
  pinMode(in2Pin, OUTPUT);
  
  Serial.println("Система инициализирована, ожидание ИК-сигнала...");
}

void loop() {
  // Если ИК-сигнал успешно принят и декодирован
  if (irrecv.decode(&results)) { 
    // Вывод в последовательный порт принятого ИК-кода в шестнадцатеричном формате (HEX)
    Serial.print("Получен ИК-код: 0x");
    Serial.println(results.value, HEX); 

    // Выполнение соответствующего действия в зависимости от кода кнопки
    switch (results.value) {
      
      // Кнопка 1 (пример): вращение вперёд (можете заменить на код кнопки "вверх" на пульте)
      case 0xFF629D: 
        setMotor(255, false); // Максимальная скорость вперёд
        Serial.println("Действие: Вентилятор вращается вперёд (FORWARD)");
        break;

      // Кнопка 2 (пример): вращение назад (можете заменить на код кнопки "вниз" на пульте)
      case 0xFFA857: 
        setMotor(255, true);  // Максимальная скорость назад
        Serial.println("Действие: Вентилятор вращается назад (BACKWARD)");
        break;

      // Кнопка 3 (пример): стоп (можете заменить на код кнопки "OK" или "стоп" на пульте)
      case 0xFF02FD: 
        setMotor(0, false);   // Скорость 0, остановка
        Serial.println("Действие: Вентилятор остановлен (STOP)");
        break;
        
      default:
        // Для неизвестных кнопок действие не выполняется
        break;
    }
    
    // Возобновление приёма следующего сигнала
    irrecv.resume(); 
  }
  
  delay(100); // Небольшая задержка, чтобы избежать слишком частого считывания при удержании кнопки
}

// --- 3. Пользовательская функция управления мотором ---
void setMotor(int speed, boolean reverse) {
  analogWrite(enablePin, speed);
  digitalWrite(in1Pin, !reverse); 
  digitalWrite(in2Pin, reverse);  
}