// --- 1. Определение пинов ультразвукового датчика ---
const int trigPin = 8;  // Пин для передачи
const int echoPin = 7;  // Пин для приема

// --- 2. Определение пинов драйвера мотора L293D ---
const int enablePin = 10; // D10: управление скоростью мотора (ШИМ)
const int in1Pin = 11;    // D11: управление направлением мотора 1
const int in2Pin = 9;     // D9:  управление направлением мотора 2

// --- 3. Настройка параметров ---
const int safeDistance = 15; // Порог безопасного расстояния установлен на 15 см

void setup() {
  // Инициализация пинов ультразвукового датчика
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  
  // Инициализация пинов управления мотором
  pinMode(enablePin, OUTPUT);
  pinMode(in1Pin, OUTPUT);
  pinMode(in2Pin, OUTPUT);
  
  // Включение последовательного порта для наблюдения данных о расстоянии на компьютере
  Serial.begin(9600);
}

void loop() {
  // ================= Шаг 1: Передача звуковой волны и измерение расстояния =================
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH); // Передача высокочастотного звукового импульса длительностью 10 микросекунд
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  
  // Измерение длительности высокого уровня на пине эхо (в микросекундах)
  long duration = pulseIn(echoPin, HIGH);
  // Расчет расстояния (скорость звука примерно 0.034 см/мкс, делим на 2 из-за пути туда и обратно)
  int distance = duration * 0.034 / 2;
  
  // Вывод текущего расстояния в монитор порта
  Serial.print("Текущее расстояние: ");
  Serial.print(distance);
  Serial.println(" см");
  
  // ================= Шаг 2: Управление запуском и остановкой мотора в зависимости от расстояния =================
  // Добавлено условие distance > 0 для предотвращения ложных срабатываний при ошибках измерения
  if (distance > 0 && distance <= safeDistance) {
    // Препятствие слишком близко! Устанавливаем скорость 0, останавливаем мотор.
    setMotor(0, false);
    Serial.println(">>> Статус: Опасность! Тормозим <<<");
  } else {
    // Перед нами безопасно! Устанавливаем скорость 255, полное вращение вперед.
    setMotor(255, false);
    Serial.println("Статус: Нормальная работа...");
  }
  
  // Небольшая задержка, чтобы избежать взаимных помех при слишком частом измерении
  delay(100); 
}

// ================= Пользовательская функция управления мотором =================
void setMotor(int speed, boolean reverse) {
  analogWrite(enablePin, speed);
  digitalWrite(in1Pin, !reverse); 
  digitalWrite(in2Pin, reverse);  
}